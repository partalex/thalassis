---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import Services from "../components/Services.astro";
import Approaches from "../components/Approaches.astro";
import WhatWeDo from "../components/WhatWeDo.astro";
import Carousel from "../components/Carousel.astro";
import HrDelimiter from "../components/HrDelimiter.astro";
import First from "../components/First.astro";
import Chart from "../components/Chart.astro";
import WhyUs from "../components/WhyUs.astro";
---
<Layout>
    <!--<Welcome welcome="Hey" />-->
    <!--<Welcome />-->

    <First></First>
    <HrDelimiter></HrDelimiter>


    <WhatWeDo></WhatWeDo>
    <HrDelimiter></HrDelimiter>


    <Carousel></Carousel>
    <HrDelimiter></HrDelimiter>


    <Services></Services>
    <HrDelimiter></HrDelimiter>


    <WhyUs></WhyUs>
    <HrDelimiter></HrDelimiter>

    <!--hide on mobile-->
    <div class="d-none d-md-block">
        <Chart></Chart>
        <HrDelimiter></HrDelimiter>
    </div>


    <!--show only on larger of small screens-->
    <div class="d-block d-md-none">
        <Approaches></Approaches>
        <HrDelimiter></HrDelimiter>
    </div>

</Layout>
