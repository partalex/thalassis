---
import Layout from "../layouts/Layout.astro";
import DarkButton from "../components/DarkButton.astro";
import Form from "../components/Form.astro";
import CenteredButton from "../components/CenteredButton.astro";

const socials: Social[] = [
    {
        icon: "bi-envelope",
        link: "hello@thalassis.co"
    },
    {
        icon: "bi-linkedin",
        link: "linkedin.com/company/thalassis-consulting"
    }
];
---
<Layout>
    <br>

    <CenteredButton>
        <DarkButton label="More Comfortable Writing In?" link="/book-app"></DarkButton>
    </CenteredButton>
    <br>
    <br>

    <div class="row">

        <div class="col-6">
            <h1 class="text-end">Contact Us</h1>
            <h6 class="text-end">Outcomes start with a conversation.</h6>
            <h6 class="text-end">Let’s talk.</h6>
            {Array.from({length: 3}).map(() => <br/>)}

            <div class="d-flex justify-content-end">
                {socials.map((social) => (
                        <a class="btn btn-outline-dark btn-lg me-2" href={social.link} target="_blank">
                            <i class={`bi ${social.icon}`}></i>
                        </a>
                ))}
            </div>

        </div>


        <div class="col-6">
            <Form></Form>
        </div>


    </div>


    <div class="row">

        <div class="col-2 offset-2">
            <a class="btn btn-outline-dark btn-lg" href="#">
                Back
            </a>
        </div>


        <div class="col-2 offset-4">
            <button class="btn btn-dark btn-lg" type="submit">
                Submit
            </button>
        </div>

    </div>
    <br>
    <br>

</Layout>