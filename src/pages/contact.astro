---
import Layout from "../layouts/Layout.astro";
import Form from "../components/Form.astro";
import CenteredButton from "../components/CenteredButton.astro";
import LargeDarkButton from "../components/LargeDarkButton.astro";
import DarkButton from "../components/DarkButton.astro";
import LightButton from "../components/LightButton.astro";
import Delimiter from "../components/Delimiter.astro";
import LargeLightButton from "../components/LargeLightButton.astro";


const socials: Social[] = [
    {
        icon: "icons/footer/LN.png",
        link: "https://linkedin.com/company/thalassis-consulting",
        text: "",
    },
    {
        icon: "icons/footer/Email.png",
        link: "mailto:hello@thalassis.co",
        text: "",
    },
];
---

<style>
    .social-icon {
        width: 40px;
        height: 40px;
        object-fit: contain;
        background: black;
        border-radius: 3px;
    }
</style>

<Layout>
    <br>

    <CenteredButton>
        <LargeDarkButton label="More Comfortable talking?" link="/book-app"></LargeDarkButton>
    </CenteredButton>

    <Delimiter></Delimiter>
    <div class="d-none d-md-block">
        <Delimiter></Delimiter>
    </div>

    <div class="row">
        <!--<div class="row mt-3 mt-md-5">-->

        <div class="col-12 col-md-5">
            <h1 class="fw-bold text-start text-md-end mb-5 mb-md-5">Contact Us</h1>

            <h5 class="text-start text-md-end">Outcomes Start With a Conversation.</h5>
            <h5 class="text-start text-md-end mb-5 mb-md-5">Let’s Talk.</h5>
            <!--{Array.from({length: 3}).map(() => <br/>)}-->

            <div class="d-flex justify-content-start justify-content-md-end mb-3">
                {socials.map((soc) => (
                        <a href={soc.link}>
                            <img src={soc.icon} alt="icon" class="social-icon py-2 me-3 me-md-0 m-md-3 ms-md-3"/>
                        </a>
                ))}
            </div>

        </div>

        <div class="d-none d-md-block col-md-1"></div>

        <div class="col-12 col-md-6 mb-4">
            <Form></Form>
        </div>


        <div class="d-none d-md-block col-6 text-center">
            <LightButton label="Back" link="/"></LightButton>
        </div>

        <div class="d-none d-md-block col-6 text-center">
            <DarkButton label="Sumbit" link="/"></DarkButton>
        </div>

        <div class="d-md-none col-12 text-center mb-4">
            <DarkButton label="Sumbit" link="/"></DarkButton>
        </div>

        <div class="d-md-none col-12 text-center">
            <LightButton label="Back" link="/"></LightButton>
        </div>


    </div>

    <br>
    <br>

</Layout>