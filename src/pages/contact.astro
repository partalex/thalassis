---
import Layout from "../layouts/Layout.astro";
import Form from "../components/Form.astro";
import CenteredButton from "../components/CenteredButton.astro";
import LargeDarkButton from "../components/LargeDarkButton.astro";
import BlackButton from "../components/BlackButton.astro";
import WhiteButton from "../components/WhiteButton.astro";
import Delimiter from "../components/Delimiter.astro";
import LargeLightButton from "../components/LargeLightButton.astro";
import ButtonSubmit from "../components/ButtonSubmit.astro";

const socials: Social[] = [
    {
        icon: "linkedin-logo",
        link: "https://linkedin.com/company/thalassis-consulting",
        text: "",
    },
    {
        icon: "envelope-simple-open",
        link: "mailto:hello@thalassis.co",
        text: "",
    },
];
---

<style>
    .social-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        margin-right: 12px;
        border-radius: 6px;
        background: black;
        overflow: hidden;
        padding-right: 16px;
        border: 1px solid #ccc;
    }

    .social-icon {
        font-size: 30px;
        color: white;
        line-height: 1;
        display: inline-block;
        position: relative;
        z-index: 3;
        transition: color 1s, transform 1s;
    }

    .social-link::before {
        content: "";
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        height: 100%;
        background: white;
        transition: top 1s;
        z-index: 2;
    }

    .social-link:hover::before {
        top: 0;
    }

    .social-link:hover .social-icon {
        color: black;
    }

    a {
        text-decoration: none !important;
    }

    @media (max-width: 600px) {
        .social-link::before {
            display: none;
            background-color: transparent;
        }

        .social-link:hover::before {
            top: 100%;
        }

        .social-link {
            width: 40px;
            height: 40px;
            background: transparent;
            margin-right: 12px;
            padding-right: 0px;
            padding-top: 0px;
        }

        .social-link:hover .social-icon {
            color: white;
        }

        .social-icon {
            object-fit: contain;
            background: black;
            border-radius: 3px;
            margin-right: 0px !important;
            transition: none !important;
        }
    }
</style>

<Layout>
    <br/>

    <CenteredButton>
        <LargeDarkButton label="More Comfortable Talking?" link="/book-app"/>
    </CenteredButton>

    <Delimiter/>
    <div class="d-none d-md-block">
        <Delimiter/>
    </div>

    <div class="row">
        <!--<div class="row mt-3 mt-md-5">-->

        <div class="col-12 col-md-5">
            <h1 class="d-none d-md-block text-md-end mb-md-5">Contact Us</h1>
            <h1 class="text-start mb-5 d-md-none" style="font-size: xxx-large ">Contact Us</h1>

            <h5 class="text-start text-md-end">
                Outcomes Start With a Conversation.
            </h5>
            <h5 class="text-start text-md-end mb-5 mb-md-5">Let’s Talk.</h5>
            <!--{Array.from({length: 3}).map(() => <br/>)}-->

            <div class="d-flex justify-content-start justify-content-md-end mb-5">
                {
                    socials.map((soc) => (
                            <a href={soc.link} class="social-link">
                                {/* <img src={soc.icon} alt="icon" class="social-icon py-2 me-3 me-md-0 m-md-3 ms-md-3"/> */}
                                <i
                                        class={`ph ph-${soc.icon} social-icon me-3 p-2 me-md-0 m-md-3 ms-md-3`}
                                />
                            </a>
                    ))
                }
            </div>
        </div>

        <div class="d-none d-md-block col-md-1"></div>

        <div class="col-12 col-md-6 mb-4">
            <Form/>
        </div>

        <!-- pc  view -->
        <div class="d-none d-md-block col-6 text-center">
            <WhiteButton label="Back" link="/"/>
        </div>

        <!-- pc  view -->
        <div class="d-none d-md-block col-6 text-center">
            <ButtonSubmit/>
        </div>

        <!-- mobile  view -->
        <div class="d-md-none col-12 text-center mb-4 mt-2">
            <ButtonSubmit/>
        </div>

        <!-- mobile  view -->
        <div class="d-md-none col-12 text-center mt-4">
            <WhiteButton label="Back" link="/"/>
        </div>
    </div>

    <br/>
    <br/>
</Layout>
