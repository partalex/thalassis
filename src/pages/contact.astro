---
import Layout from "../layouts/Layout.astro";
import Form from "../components/Form.astro";
import CenteredButton from "../components/CenteredButton.astro";
import LargeDarkButton from "../components/LargeDarkButton.astro";
import DarkButton from "../components/DarkButton.astro";
import LightButton from "../components/LightButton.astro";

const socials: Social[] = [
    {
        icon: "bi-envelope",
        link: "hello@thalassis.co"
    },
    {
        icon: "bi-linkedin",
        link: "linkedin.com/company/thalassis-consulting"
    }
];
---
<Layout>
    <br>

    <CenteredButton>
        <LargeDarkButton label="More comfortable talking?" link="/book-app"></LargeDarkButton>
    </CenteredButton>

    <div class="row mt-3 mt-md-5">

        <div class="col-md-5">
            <h1 class="fw-bold text-start text-md-end mb-md-5">Contact Us</h1>
            <h6 class="text-start text-md-end">Outcomes start with a conversation.</h6>
            <h6 class="text-start text-md-end mb-3 mb-md-5">Let’s talk.</h6>
            <!--{Array.from({length: 3}).map(() => <br/>)}-->

            <div class="d-flex justify-content-start justify-content-md-end">
                {socials.map((social) => (
                        <a class="btn btn-outline-dark btn-lg me-2" href={social.link} target="_blank">
                            <i class={`bi ${social.icon}`}></i>
                        </a>
                ))}
            </div>

        </div>

        <div class="col-md-1"></div>

        <div class="col-md-6">
            <Form></Form>
        </div>


        <div class="col-6 text-center">
            <LightButton label="Back" link="/"></LightButton>
        </div>


        <div class="col-6 text-center">
            <button class="btn btn-dark btn-lg" type="submit">
                Submit
            </button>
        </div>
    </div>

    <br>
    <br>

</Layout>