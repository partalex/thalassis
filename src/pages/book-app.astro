---
import WhiteButton from "../components/WhiteButton.astro";
import CenteredButton from "../components/CenteredButton.astro";
import Layout from "../layouts/Layout.astro";
import LargeDarkButton from "../components/LargeDarkButton.astro";
import AppointmentCard from "../components/AppointmentCard.astro";

const socials: Social[] = [
    {
        icon: "linkedin-logo",
        link: "https://linkedin.com/company/thalassis-consulting",
        text: "",
    },
    {
        icon: "envelope-simple-open",
        link: "mailto:hello@thalassis.co",
        text: "",
    },
];
---

<style>
    .social-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        margin-right: 12px;
        border-radius: 6px;
        background: black;
        overflow: hidden;
        padding-right: 16px;
        border: 1px solid #ccc;
    }

    .social-icon {
        font-size: 30px;
        color: white;
        line-height: 1;
        display: inline-block;
        position: relative;
        z-index: 3;
        transition: color 1s, transform 1s;
    }

    .social-link::before {
        content: "";
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        height: 100%;
        background: white;
        transition: top 1s;
        z-index: 2;
    }

    .social-link:hover::before {
        top: 0;
    }

    .social-link:hover .social-icon {
        color: black;
    }

    a {
        text-decoration: none !important;
    }

    @media (max-width: 600px) {
        .social-link::before {
            display: none;
            background-color: transparent;
        }

        .social-link:hover::before {
            top: 100%;
        }

        .social-link {
            width: 40px;
            height: 40px;
            background: transparent;
            margin-right: 12px;
            padding-right: 0px;
            padding-top: 0px;
        }

        .social-link:hover .social-icon {
            color: white;
        }

        .social-icon {
            object-fit: contain;
            background: black;
            border-radius: 3px;
            margin-right: 0px !important;
            transition: none !important;
        }
    }
</style>

<Layout>

    <CenteredButton>
        <LargeDarkButton label="More Comfortable Writing In?" link="/contact"></LargeDarkButton>
    </CenteredButton>
    <br>
    <br>

    <!-- pc view -->
    <div class="d-none d-md-flex row mt-4">

        <div class="col-5">
            <h1 class="text-end">Book an</h1>
            <h1 class="text-end mb-5">Appointment</h1>
        </div>

        <!--<div class="col-6 offset-1">-->
        <!--    <div class="d-flex align-items-center justify-content-center">-->
        <!--        <h4 class="d-inline-flex align-items-center">-->
        <!--            <i class="ph ph-calendar-blank me-2"></i>-->
        <!--            Select Appointment-->
        <!--        </h4>-->
        <!--    </div>-->
        <!--</div>-->

        <div class="col-6 offset-1  align-content-start text-center">
            <h4 class="d-inline-flex align-items-center mt-4">
                <i class="ph ph-calendar-blank me-2"></i>
                Select Timeslot
            </h4>
            <!--<h4 class="text-center">-->
            <!--    <i class="ph ph-calendar-blank me-2"  ></i>-->
            <!--    Select Appointment-->
            <!--</h4>-->
        </div>

        <div class="col-5">
            <h5 class="text-end">Prefer to talk?</h5>
            <h5 class="text-end">Schedule a 30-minute intro call</h5>
            <h5 class="text-end">with Thalassis to discuss your</h5>
            <h5 class="text-end">project.</h5>
            <div class="d-flex justify-content-end mb-5 mt-5">
                {socials.map((soc) => (
                        <a href={soc.link} class="social-link">
                            <i class={`ph ph-${soc.icon} social-icon me-3 p-2 me-md-0 m-md-3 ms-md-3`}/>
                        </a>
                ))}
            </div>
        </div>

        <div class="col-6 offset-1">
            <AppointmentCard></AppointmentCard>
        </div>
    </div>

    <!-- mobile view -->
    <div class="row d-md-none">

        <div class="col-12">

            <h1 style="font-size: xx-large">Book an</h1>
            <h1 style="font-size: xx-large" class="mb-5">Appointment</h1>

            <h2>Prefer to talk?</h2>
            <h2>Schedule a 30-minute intro call</h2>
            <h2>30-min intro call with</h2>
            <h2>with Thalassis to discuss</h2>
            <h2 class="mb-4">your project.</h2>
        </div>

        <div class="col-12 mt-4">
            <div class="d-flex justify-content-start mb-3">
                {socials.map((soc) => (
                        <a href={soc.link} class="me-3 mb-4">
                            <i class={`ph ph-${soc.icon} social-icon p-2`}/>
                            <!--<img src={soc.icon} alt="icon" class="social-icon py-2 me-3"/>-->
                        </a>
                ))}
            </div>
        </div>


        <div class="col-12">

            <div class="d-flex d-md-nofne align-items-center justify-content-center mb-4">
                <h4 class="d-inline-flex align-items-center">
                    <i class="ph ph-calendar-blank me-2"></i>
                    Select Timeslot
                </h4>
            </div>

            <AppointmentCard></AppointmentCard>


        </div>
    </div>

    <div class="d-none d-md-block" style="margin-block: 50px"></div>

    <div class="row my-5 my-md-4 text-center">

        <!-- pc view -->
        <div class="col-6 d-none d-md-block"></div>


        <!-- mobile view -->
        <div class="col-6 d-none d-md-block">
            <WhiteButton label="Back" link="/"></WhiteButton>
        </div>

        <!-- mobile view -->
        <div class="col-12 d-md-none">
            <WhiteButton label="Back" link="/"></WhiteButton>
        </div>

    </div>

    <!-- pc view -->
    <div class="d-none d-md-block" style="margin-block: 45px"></div>


</Layout>
