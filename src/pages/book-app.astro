---
import LightButton from "../components/LightButton.astro";
import CenteredButton from "../components/CenteredButton.astro";
import Layout from "../layouts/Layout.astro";
import LargeDarkButton from "../components/LargeDarkButton.astro";
import HrDelimiter from "../components/HrDelimiter.astro";
import Delimiter from "../components/Delimiter.astro";
import LargeLightButton from "../components/LargeLightButton.astro";
import DarkButton from "../components/DarkButton.astro";

const appointments: Appointment[] = [
    {
        name: "Free Consultation",
        desc: "30 minutes",
        link: "https://calendly.com/thalassis/30min",
    },
    {
        name: "Basic Service",
        desc: "1 hour @ $99.00",
        link: "https://calendly.com/thalassis/1hour-basic-service",
    },
    {
        name: "Advanced Service",
        desc: "1 hour @ $199.00",
        link: "https://calendly.com/thalassis/1hour-advanced-service",
    }
];

const socials: Social[] = [
    {
        icon: "icons/footer/LN.png",
        link: "https://linkedin.com/company/thalassis-consulting",
        text: "",
    },
    {
        icon: "icons/footer/Email.png",
        link: "mailto:hello@thalassis.co",
        text: "",
    },
];
---

<style>
    .social-icon {
        width: 40px;
        height: 40px;
        object-fit: contain;
        background: black;
        border-radius: 3px;
    }
</style>

<Layout>

    <CenteredButton>
        <LargeDarkButton label="More Comfortable Writing In?" link="/contact"></LargeDarkButton>
    </CenteredButton>
    <br>
    <br>

    <div class="row mt-md-4">

        <div class="col-12 col-md-5 d-none d-md-block">
            <!--<div class={`col-12 col-${br}-5`}> -->

            <h1 class="text-md-end">Book an</h1>
            <h1 class="text-md-end mb-5 mb-md-5">Appointment</h1>

            <h5 class="text-end">More comfortable talking?</h5>
            <h5 class="text-end">No problem. Schedule a</h5>
            <h5 class="text-end">30-min intro call with</h5>
            <h5 class="text-end">Thalassis to chat about</h5>
            <h5 class="text-end">your inquiry.</h5>
        </div>

        <div class="col-12 col-md-5 d-md-none">
            <!--<div class={`col-12 col-${br}-5`}> -->

            <h1>Book an</h1>
            <h1 class="mb-md-5">Appointment</h1>

            <h5>More comfortable talking?</h5>
            <h5>No problem. Schedule a 30-min intro</h5>
            <h5>call with Thalassis to chat about your</h5>
            <h5>inquiry.</h5>
        </div>

        <div class="col-12 d-md-none mt-4">
            <div class="d-flex justify-content-start justify-content-md-end mb-3">
                {socials.map((soc) => (
                        <a href={soc.link}>
                            <img src={soc.icon} alt="icon" class="social-icon py-2 me-3 me-md-0 m-md-3 ms-md-3"/>
                        </a>
                ))}
            </div>
        </div>


        <!--LinkedIn and email icon-->
        <div class="d-none d-md-block col-md-1"></div>


        <div class="col-12 col-md-6">

            <div class="d-flex d-md-none align-items-center justify-content-center mb-4 mb-md-5">
                <h4 class="d-inline-flex align-items-center">
                    <i class="ph ph-calendar-blank me-2"></i>
                    Select Appointment
                </h4>
            </div>

            <div class="shadow p-3 p-md-5">
                {appointments.map((app, index) => (
                        <>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="mb-0">{app.name}</h4>
                                    <small class="text-muted">{app.desc}</small>
                                </div>
                                <DarkButton label="Book" link={app.link}></DarkButton>
                            </div>
                            {index < appointments.length - 1 &&
                                    <HrDelimiter/>}
                        </>
                ))}
            </div>

        </div>
    </div>

    <div class="d-none d-md-block" style="margin-block: 40px"></div>

    <div class="row my-5 my-md-4 text-center">

        <!-- desktop view -->
        <div class="col-6 d-none d-md-block"></div>


        <div class="col-6 d-none d-md-block">
            <LightButton label="Back" link="/"></LightButton>
        </div>

        <!-- mobile view -->
        <div class="d-md-none col-12">
            <LightButton label="Back" link="/"></LightButton>
        </div>

    </div>

    <div class="d-none d-${br}-block" style="margin-block: 20px"></div>


</Layout>
