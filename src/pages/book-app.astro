---
import WhiteButton from "../components/WhiteButton.astro";
import CenteredButton from "../components/CenteredButton.astro";
import Layout from "../layouts/Layout.astro";
import LargeDarkButton from "../components/LargeDarkButton.astro";
import AppointmentCard from "../components/AppointmentCard.astro";
import Socials from "../components/Socials.astro";

---

<Layout>

    <CenteredButton>
        <LargeDarkButton label="More Comfortable Writing In?" link="/contact"></LargeDarkButton>
    </CenteredButton>
    <br>
    <br>

    <!-- pc view -->
    <div class="d-none d-md-flex row mt-4">

        <div class="col-5">
            <h1 class="text-end">Book an</h1>
            <h1 class="text-end mb-5">Appointment</h1>
        </div>

        <!--<div class="col-6 offset-1">-->
        <!--    <div class="d-flex align-items-center justify-content-center">-->
        <!--        <h4 class="d-inline-flex align-items-center">-->
        <!--            <i class="ph ph-calendar-blank me-2"></i>-->
        <!--            Select Appointment-->
        <!--        </h4>-->
        <!--    </div>-->
        <!--</div>-->

        <div class="col-6 offset-1  align-content-start text-center">
            <h4 class="d-inline-flex align-items-center mt-4">
                <i class="ph ph-calendar-blank me-2"></i>
                Select Timeslot
            </h4>
            <!--<h4 class="text-center">-->
            <!--    <i class="ph ph-calendar-blank me-2"  ></i>-->
            <!--    Select Appointment-->
            <!--</h4>-->
        </div>

        <div class="col-5">
            <h5 class="text-end">Prefer to talk?</h5>
            <h5 class="text-end">Schedule a 30-minute intro call</h5>
            <h5 class="text-end">with Thalassis to discuss your</h5>
            <h5 class="text-end">project.</h5>

            <Socials></Socials>

        </div>

        <div class="col-6 offset-1">
            <AppointmentCard></AppointmentCard>
        </div>
    </div>

    <!-- mobile view -->
    <div class="row d-md-none">

        <div class="col-12">

            <h1 style="font-size: xx-large">Book an</h1>
            <h1 style="font-size: xx-large" class="mb-5">Appointment</h1>

            <h5>Prefer to talk?</h5>
            <h5>Schedule a 30-minute intro call</h5>
            <h5>30-min intro call with Thalassis</h5>
            <h5 >to discuss your project.</h5>
        </div>

        <div class="col-12">
            <Socials></Socials>
        </div>


        <div class="col-12">

            <div class="d-flex d-md-nofne align-items-center justify-content-center mb-4">
                <h4 class="d-inline-flex align-items-center">
                    <i class="ph ph-calendar-blank me-2"></i>
                    Select Timeslot
                </h4>
            </div>

            <AppointmentCard></AppointmentCard>


        </div>
    </div>

    <div class="d-none d-md-block" style="margin-block: 50px"></div>

    <div class="row my-5 my-md-4 text-center">

        <!-- pc view -->
        <div class="col-6 d-none d-md-block"></div>


        <!-- mobile view -->
        <div class="col-6 d-none d-md-block">
            <WhiteButton label="Back" link="/"></WhiteButton>
        </div>

        <!-- mobile view -->
        <div class="col-12 d-md-none">
            <WhiteButton label="Back" link="/"></WhiteButton>
        </div>

    </div>

    <!-- pc view -->
    <div class="d-none d-md-block" style="margin-block: 45px"></div>


</Layout>
