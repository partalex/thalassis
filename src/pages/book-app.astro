---
import LightButton from "../components/LightButton.astro";
import CenteredButton from "../components/CenteredButton.astro";
import Layout from "../layouts/Layout.astro";
import LargeDarkButton from "../components/LargeDarkButton.astro";
import HrDelimiter from "../components/HrDelimiter.astro";
import Delimiter from "../components/Delimiter.astro";
import LargeLightButton from "../components/LargeLightButton.astro";
import DarkButton from "../components/DarkButton.astro";

const br ="lg"
const appointments: Appointment[] = [
    {
        name: "Free Consultation",
        desc: "30 minutes",
        link: "https://calendly.com/thalassis/30min",
    },
    {
        name: "Basic Service",
        desc: "1 hour @ $99.00",
        link: "https://calendly.com/thalassis/1hour-basic-service",
    },
    {
        name: "Advanced Service",
        desc: "1 hour @ $199.00",
        link: "https://calendly.com/thalassis/1hour-advanced-service",
    }
];
---

<Layout>

    <CenteredButton>
        <LargeDarkButton label="More Comfortable Writing In?" link="/contact"></LargeDarkButton>
    </CenteredButton>
    <br>
    <br>

    <div class={`row mt-${br}-4`}></div>

        <!--<div class="col-12 col-md-5 d-none d-md-block">-->
        <div class="col-12 col-md-5">

            <h1 class={`text-start text-${br}-end`}>Book an</h1>
            <h1 class={`text-start text-${br}-end mb-5 mb-${br}-5`}>Appointment</h1>

            <h5 class={`text-start text-${br}-end`}>More comfortable talking?</h5>
            <h5 class={`text-start text-${br}-end`}>No problem. Schedule a 30-min intro</h5>
            <h5 class={`text-start text-${br}-end`}>call with Thalassis to chat about your</h5>
            <h5 class={`text-start text-${br}-end`}>inquiry.</h5>


        </div>

        <!--LinkedIn and email icon-->
        <!--<div class="d-none d-md-block col-md-1"></div>-->
        <div class={`d-none d-${br}-block col-${br}-1`}></div>



        <!--<div class="col-12 col-md-6">-->
        <div class={`col-12 col-${br}-6`}>

            <div class="d-flex align-items-center justify-content-center mb-5">
                <i class="ph ph-calendar-blank me-2"></i>
                <h4>Select Appointment</h4>
            </div>


            <!--<div class="shadow p-3 p-md-5">-->
            <div class={`shadow p-3 p-${br}-5`}>
                {appointments.map((app, index) => (
                        <>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h4 class="mb-0">{app.name}</h4>
                                    <small class="text-muted">{app.desc}</small>
                                </div>
                                <DarkButton label=book link="/"></DarkButton>
                                <!--<a class="btn btn-dark" href={app.link}>Book</a>-->
                            </div>
                            <HrDelimiter></HrDelimiter>
                            <!--{index < app.length - 1 && <HrDelimiter />}-->
                        </>
                ))}
            </div>

        </div>

        <!--<div class="d-none d-md-block" style="margin-block: 40px"></div>-->
        <div class={`d-none d-${br}-block`} style="margin-block: 40px"></div>

        <div class={`row my-5 my-${br}-4 text-center`}>

            <!-- desktop view -->
            <div class={`col-6 d-none d-${br}-block`}></div>


            <div class={`col-6 d-none d-${br}block`}>
                <LightButton label="Back" link="/"></LightButton>
            </div>

            <!-- mobile view -->
            <div class={`d-${br}-none col-12`}>
                <LightButton label="Back" link="/"></LightButton>
            </div>

        </div>

        <div class={`d-none d-${br}-block`} style="margin-block: 20px"></div>


    </div>


</Layout>
