---
import LightButton from "../components/LightButton.astro";
import CenteredButton from "../components/CenteredButton.astro";
import Layout from "../layouts/Layout.astro";
import LargeDarkButton from "../components/LargeDarkButton.astro";
import HrDelimiter from "../components/HrDelimiter.astro";
import Delimiter from "../components/Delimiter.astro";
import LargeLightButton from "../components/LargeLightButton.astro";
const appointments: Appointment[] = [
    {
        name: "Free Consultation",
        desc: "30 minutes",
        link: "https://calendly.com/thalassis/30min",
    },
    {
        name: "Basic Service",
        desc: "1 hour @ $99.00",
        link: "https://calendly.com/thalassis/1hour-basic-service",
    },
    {
        name: "Advanced Service",
        desc: "1 hour @ $199.00",
        link: "https://calendly.com/thalassis/1hour-advanced-service",
    }
];
---

<Layout>

    <CenteredButton>
        <LargeDarkButton label="More Comfortable Writing In?" link="/contact"></LargeDarkButton>
    </CenteredButton>
    <br>
    <br>

    <div class="row">

        <div class="col-6">

            <h1 class="fw-bold text-start text-md-end">Book an</h1>
            <h1 class="fw-bold text-start text-md-end mb-5 mb-md-5">Appointment</h1>

            <h4 class="text-start text-md-end">More comfortable talking?</h4>
            <h4 class="text-start text-md-end">No problem. Schedule a 30-min intro</h4>
            <h4 class="text-start text-md-end">call with Thalassis to chat about your</h4>
            <h4 class="text-start text-md-end">inquiry.</h4>


            <!--LinkedIn and email icon-->

        </div>

        <div class="col-6">
            <div class="d-flex align-items-center justify-content-center mb-5">
                <i class="ph ph-calendar-blank me-2"></i>
                <h6>Select Appointment</h6>
            </div>


            <div class="card shadow-sm p-5">
                {appointments.map((app, index) => (
                        <>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h4 class="mb-0">{app.name}</h4>
                                    <small class="text-muted">{app.desc}</small>
                                </div>
                                <a class="btn btn-dark" href={app.link}>Book</a>
                            </div>
                            <!--{index < app.length - 1 && <HrDelimiter/>}-->
                        </>
                ))}
            </div>

        </div>

        <div class="mt-5 ms-auto col-6">
            <LargeLightButton label="Back" link="/"></LargeLightButton>
        </div>
    </div>


</Layout>
