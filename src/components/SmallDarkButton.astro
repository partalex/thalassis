---
const {label, link} = Astro.props;
---

<style>
    .a {
        font-weight: 300;
        max-width: 200px !important;
        width: 110px !important;
    }
</style>

<a
        href={link}
        class="btn btn-dark btn-lg black-btn offset-shadow"
        style="border-radius: 3px;
    font-weight: 200;
    min-width: 110px;
    min-height: 40px;
    font-size: 1rem;
   "
>{label}</a
>
