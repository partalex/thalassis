---
const navLinks: NavLink[] = [
    {href: "/about", name: "About Us"},
    {href: "/case-studies", name: "Case Studies"},
    {href: "/contact", name: "Contact Us"},
];

const logoPath = "/public/logo/svg/THALASSIS CONSULTING LOGO-Black.svg";
---

<style>

</style>

<ul class="nav justify-content-end">
    <img src={logoPath} alt="Thalassis Consulting Logo" class="logo"/>

    {navLinks.map(link => (
            <li class="nav-item">
                <a class="nav-link" aria-current="page" href={link.href}>{link.name}</a>
            </li>
    ))}

</ul>

