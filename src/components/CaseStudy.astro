---

<h1 class="mb-4 mb-md-5 font-size" style="font-size: xxx-large">Case Studies</h1>

<Delimiter />

<div class="row mb-5">
    {
        caseStudies.map((cs, index) => (
            <>
                <div class="col-12 d-md-none text-center mb-4">
                    <img
                        src={cs.image}
                        alt={cs.title}
                        class="img-fluid mb-3"
                        style="max-width: 120px;"
                    />
                </div>

                <div class="col-md-9">
                    <h1 class="mb-4 mb-md-5">{cs.title}</h1>
                    <h5 >{cs.subtitle}</h5>
                </div>

                <div class="d-none d-md-block col-md-3 text-end">
                    <img
                        src={cs.image}
                        alt={cs.title}
                        class="img-fluid mb-3"
                        style="max-width: 120px;"
                    />
                </div>

                <div class="col-md-12">
                    <div class="mt-5">
                        <h6 class="fw-medium">The Challenge</h6>
                        <p class="fw-lighter text-muted">{cs.challenge.desc}</p>
                    </div>

                    <div class="mt-4">
                        <h6 class="fw-medium mt-5">Our Role</h6>
                        <p class="fw-lighter text-muted">{cs.role.desc}</p>
                        <ul class="ps-0" style="list-style-position: inside;">
                            {cs.role.bullets.map((b) => (
                                <li class="mb-3">
                                    <span class="fw-semibold" style="margin-left: 1rem;">{b.title}</span>
                                    <p class="text-muted d-inline" > {b.desc}</p>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="mt-5 mb-5">
                        <h6 class="fw-medium">The Outcome</h6>
                        <p class="text-muted">{cs.outcome.desc}</p>
                    </div>
                </div>
                {index < caseStudies.length - 1 && <HrDelimiter />}
            </>
        ))
    }
</div>
