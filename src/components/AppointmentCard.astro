---
import BlackButton from "./BlackButton.astro";
import SmallBlackButton from "./SmallBlackButton.astro";

const apps: Appointment[] = [
    {
        name: "Free Consultation",
        desc: "30 minutes",
        link: "https://calendly.com/thalassis/30min",
    },
    {
        name: "Basic Service",
        desc: "1 hour @ $99.00",
        link: "https://calendly.com/thalassis/1hour-basic-service",
    },
    {
        name: "Advanced Service",
        desc: "1 hour @ $199.00",
        link: "https://calendly.com/thalassis/1hour-advanced-service",
    }
];
---

<div class="container shadow px-4 py-5 px-md-3 px-md-5" style="max-width: 550px">
    <div class="row row-cols-1"></div>
    {apps.map((app, index) => (
            <>
                <div class="col gx-4 gy-5 gx-md-3 gy-md-5">

                    <div class="d-flex align-items-center">
                        <div class="me-auto">
                            <h4 style="" class="mb-1">{app.name}</h4>
                            <p class="mb-0">{app.desc}</p>
                        </div>
                        <div class="d-none d-md-block">
                            <BlackButton label="Book" link={app.link}></BlackButton>
                        </div>
                        <div class="d-md-none">
                            <SmallBlackButton label="Book" link={app.link}></SmallBlackButton>
                        </div>

                    </div>

                    {index < apps.length - 1 &&
                            <hr class="m-0 my-5 my-md-5"/>}
                </div>
            </>
    ))}
</div>

