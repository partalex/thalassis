---
import BlackButton from "./BlackButton.astro";
import HrDelimiter from "./HrDelimiter.astro";
const logoPath = "/logo/svg/THALASSIS CONSULTING LOGO-Black.svg";

const apps: Appointment[] = [
    {
        name: "Free Consultation",
        desc: "30 minutes",
        link: "https://calendly.com/thalassis/30min",
    },
    {
        name: "Basic Service",
        desc: "1 hour @ $99.00",
        link: "https://calendly.com/thalassis/1hour-basic-service",
    },
    {
        name: "Advanced Service",
        desc: "1 hour @ $199.00",
        link: "https://calendly.com/thalassis/1hour-advanced-service",
    }
];
---

<!--<div class="container shadow" style="width: 500px">-->
<div class="container shadow p-5">
    <div class="row row-cols-1"></div>
    {apps.map((app, index) => (
            <>
                <div class="col g-5" key={index}>

                    <div class="d-flex align-items-center">
                        <div class="me-auto">
                            <h4 class="mb-1">{app.name}</h4>
                            <p class="mb-0">{app.desc}</p>
                        </div>
                        <div>
                            <BlackButton label="Book" link={app.link}></BlackButton>
                        </div>
                    </div>

                    {index < apps.length - 1 &&
                            <hr class="m-0 my-5"/>}
                </div>
            </>
    ))}
</div>

