---
import BlackButton from "./BlackButton.astro";
import CenteredButton from "./CenteredButton.astro";
import Delimiter from "./Delimiter.astro";

const carouselItems = [
    {imagePath: "/company-logos/Lseg/LSEG Square Black.svg", alt: "LSEG logo"},
    {
        imagePath: "/company-logos/360 JetFuel/360 JetFuel - Black.svg",
        alt: "360 - jetfuel logo",
    },
    {
        imagePath: "/company-logos/Bankwards Box/Bankwards Box - Black.svg",
        alt: "Bankwards Box logo",
    },
    // {imagePath: "/company-logos/FIS/5. FIS.svg", alt: "FIS logo"},
    {
        imagePath: "public/company-logos/Meinhardt/1. Meinhardt Logo - bez crvene tacke.svg",
        alt: "Meinhardt logo",
    },
    {imagePath: "/company-logos/NDA/NDA - Black.svg", alt: "NDA logo"},
    {imagePath: "/company-logos/EPS/EPS.svg", alt: "EPS logo"},
];
---

<div class="d-none d-md-block mb-5">
    <h1 class="fw-bold">Who We Have Worked With</h1>
</div>

<div class="d-md-none mb-5">
    <h1>Who We Have</h1>
    <h1>Worked With</h1>
</div>

<div class="section-slider custom-carousel">
    <ul class="list">
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
    </ul>
    <div class="swipe"></div>
</div>

<div id="mobileCarousel" class="carousel slide bootstrap-carousel" data-bs-ride="carousel">
    <div class="carousel-inner">
        {carouselItems.map((item, index) => (
                <div class={`carousel-item ${index === 0 ? "active" : ""}`}>
                    <div class="carousel-image-wrapper">
                        <img src={item.imagePath} alt={item.alt}/>
                    </div>
                </div>
        ))}
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#mobileCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#mobileCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>


<CenteredButton>
    <BlackButton label="Find Out More" link="/"/>
</CenteredButton>

<script type="module" is:inline>
    window.carouselItems =[
        {
            imagePath: "/company-logos/360 JetFuel/360 JetFuel - Black.svg",
            alt: "360 - jetfuel logo",
        },
        {
            imagePath: "/company-logos/Bankwards Box/Bankwards Box - Black.svg",
            alt: "Bankwards Box logo",
        },
        {imagePath: "/company-logos/Lseg/LSEG Square Black.svg", alt: "LSEG logo"},

        // {imagePath: "/company-logos/FIS/5. FIS.svg", alt: "FIS logo"},
        {
            imagePath: "public/company-logos/Meinhardt/1. Meinhardt Logo - bez crvene tacke.svg",
            alt: "Meinhardt logo",
        },
        {imagePath: "/company-logos/NDA/NDA - Black.svg", alt: "NDA logo"},
        {imagePath: "/company-logos/EPS/EPS.svg", alt: "EPS logo"},
    ];
</script>

<style>
.section-slider {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    margin-top: 4rem;
    }

.list {
    display: flex;
    position: relative;
    gap: 1rem;
    height: 200px;
    justify-content: center;
    align-items: center;
    margin-bottom: 1rem;
    }

.swipe {
    width: 270px;
    height: 50px;
    background-color: transparent;
    border-radius: 2px;
    opacity: 0.1; /* test vidljivosti */
    }

.list li {
    list-style-type: none;
    width: 200px;
    height: 200px;
    opacity: 0.25;
    position: absolute;
    left: 50%;
    margin-left: -100px;
    border-radius: 2px;
    background: transparent;
    transition:
    transform 1s,
    opacity 1s;
    }

.list .act {
    opacity: 1;
    }

.list .prev,
.list .next {
    cursor: pointer;
    }

.list .prev {
    transform: translateX(-220px) scale(0.85);
    }

.list .next {
    transform: translateX(220px) scale(0.85);
    }

.list .hide {
    transform: translateX(-420px) scale(0.85);
    }

.list .new-next {
    transform: translateX(420px) scale(0.85);
    }

.list .hide,
.list .new-next {
    opacity: 0;
    transition:
    opacity 0.5s,
    transform 0.5s;
    }

/* === MOBILE BOOTSTRAP CAROUSEL === */

#mobileCarousel {
    position: relative;
    overflow: visible;
    max-width: 280px;
    margin: 0 auto;
    }

#mobileCarousel .carousel-inner {
    height: 200px;
    display: flex;
    /* align-items: center; */
    /* justify-content: centera; */
    }

#mobileCarousel .carousel-item {
    height: 100%;
    }

#mobileCarousel .carousel-image-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    }

#mobileCarousel .carousel-item img {
    max-width: 100%;
    max-width: 150px; /* limit visine slike */
    object-fit: contain;
    margin: 0 auto;
    }

#mobileCarousel .carousel-control-prev,
#mobileCarousel .carousel-control-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background-color: black;
    /* border-radius: 50%; */
    opacity: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    }

#mobileCarousel .carousel-control-prev {
    left: -20px; /* lepo unutar okvira */
    }

#mobileCarousel .carousel-control-next {
    right: -20px; /* lepo unutar okvira */
    }

#mobileCarousel .carousel-control-prev-icon,
#mobileCarousel .carousel-control-next-icon {
    background-size: 60% 60%;
    }

@media (max-width: 480px) {
    #mobileCarousel .carousel-control-prev,
    #mobileCarousel .carousel-control-next {
    width: 32px;
    height: 32px;
    }
    }

/* === SHOW/HIDE SWITCH === */

.custom-carousel {
    display: block;
    }

.bootstrap-carousel {
    display: none;
    }

@media (max-width: 768px) {
    .custom-carousel {
    display: none;
    }

    .bootstrap-carousel {
    display: block;
    }
    }
</style>

<script type="module" is:inline>
import Hammer from "https://cdn.skypack.dev/hammerjs";

const listEls = document.querySelectorAll(".list li");
let currentIndex = 2; // start from center

const classMap = ["hide", "prev", "act", "next", "next new-next"];

function renderCarousel() {
    const items = window.carouselItems;
    const total = items.length;

    listEls.forEach((li, i) => {
        const index = (currentIndex + i - 2 + total) % total;
        const item = items[index];

        li.className = classMap[i];
        li.innerHTML = `
        <img src="${item.imagePath}" alt="${item.alt}" style="width:100%; height:100%; object-fit:contain;" />
      `;
        });
    }

function next() {
    currentIndex = (currentIndex + 1) % window.carouselItems.length;
    renderCarousel();
    }

function prev() {
    currentIndex =
        (currentIndex - 1 + window.carouselItems.length) %
            window.carouselItems.length;
    renderCarousel();
    }

document.querySelector(".list").addEventListener("click", (e) => {
    const li = e.target.closest("li");
    if (!li) return;
    if (li.classList.contains("next")) next();
    else if (li.classList.contains("prev")) prev();
    });

const swipe = new Hammer(document.querySelector(".swipe"));
swipe.on("swipeleft", next);
swipe.on("swiperight", prev);

renderCarousel();
</script>
