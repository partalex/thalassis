<!DOCTYPE html>
<style>
    .flowchart {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-family: Arial, sans-serif;
    }

    .step, .decision {
        border: 1px solid #000;
        padding: 10px;
        margin: 10px;
        text-align: center;
        width: 200px;
        position: relative;
    }

    .step {
        border-radius: 10px;
    }

    .decision {
        width: 220px;
        height: 220px;
        transform: rotate(45deg);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
    }

    .decision > div {
        transform: rotate(-45deg);
        width: 150px;
        text-align: center;
    }

    .connector {
        width: 2px;
        height: 40px;
        background-color: #000;
        margin: -10px 0;
    }

    .horizontal-line {
        width: 100px;
        height: 2px;
        background-color: #000;
        position: relative;
        margin: 0 20px;
    }

    .label-left, .label-right {
        position: absolute;
        top: -25px;
        font-weight: bold;
        background-color: #fff;
        padding: 0 5px;
    }

    .label-left {
        left: 0;
        transform: rotate(-45deg);
    }

    .label-right {
        right: 0;
        transform: rotate(45deg);
    }

    .branch-wrapper {
        display: flex;
        justify-content: space-between;
        width: 500px;
        margin-top: 20px;
    }

    .branch {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .branch-label {
        font-weight: bold;
        margin-bottom: 10px;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
    }

    .vertical-line {
        width: 2px;
        height: 80px;
        background-color: #000;
        margin: 0 auto;
    }

    .horizontal-connector {
        height: 2px;
        width: 100px;
        background-color: #000;
        position: absolute;
        top: 50%;
    }

    .horizontal-left {
        left: -100px;
    }

    .horizontal-right {
        right: -100px;
    }
</style>
<div class="flowchart">

    <div class="step">
        1 - Scope
        <br>
        Each engagement starts with a Scope of Work (SOW)—a shared under-standing of what we’re solving.
    </div>
    <div class="connector"></div>

    <div class="step">
        1 - Scope
        <br>
        Each engagement starts with a Scope of Work (SOW)—a shared under-standing of what we’re solving.
    </div>
    <div class="connector"></div>

    <!-- Decision Diamond -->
    <div class="decision" style="margin-top: 50px; position: relative;">
        <div>
            <strong>1 - Scope</strong><br>
            Each engagement starts with a Scope of Work (SOW)—a shared understanding of what we’re solving.
        </div>

        <!-- Horizontal lines extending left and right -->
        <div class="horizontal-connector horizontal-left"></div>
        <div class="horizontal-connector horizontal-right"></div>
    </div>

    <!-- Split branches from left and right of the diamond -->
    <div class="branch-wrapper">
        <div class="branch">
            <div class="vertical-line"></div>
            <div class="branch-label">Fixed</div>
            <div class="vertical-line"></div>
        </div>
        <div class="branch">
            <div class="vertical-line"></div>
            <div class="branch-label">Flexible</div>
            <div class="vertical-line"></div>
        </div>
    </div>

    <div class="step">
        1 - Scope
        <br>
        Each engagement starts with a Scope of Work (SOW)—a shared under-standing of what we’re solving.
    </div>

</div>
