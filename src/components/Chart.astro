<!DOCTYPE html>
<style>
    .flowchart {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-family: Arial, sans-serif;
    }

    .step, .decision {
        border: 1px solid #000;
        padding: 10px;
        margin: 10px;
        text-align: center;
        width: 200px;
        position: relative;
    }

    .step {
        background-color: white;
        border-radius: 10px;
    }

    .decision {
        background-color: #fff3cd;
        width: 220px;
        height: 220px;
        transform: rotate(45deg);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
    }

    .decision > div {
        transform: rotate(-45deg);
        width: 150px;
        text-align: center;
    }

    .connector {
        width: 2px;
        height: 40px;
        background-color: #000;
        margin: -10px 0;
    }

    .horizontal-line {
        width: 100px;
        height: 2px;
        background-color: #000;
        position: relative;
        margin: 0 20px;
    }

    .label-left, .label-right {
        position: absolute;
        top: -25px;
        font-weight: bold;
        background-color: #fff;
        padding: 0 5px;
    }

    .label-left {
        left: 0;
        transform: rotate(-45deg);
    }

    .label-right {
        right: 0;
        transform: rotate(45deg);
    }
</style>
<div class="flowchart">

    <div class="step">
        1 - Scope
        <br>
        Each engagement starts with a Scope of Work (SOW)—a shared under-standing of what we’re solving.
    </div>
    <div class="connector"></div>

    <div class="step">
        1 - Scope
        <br>
        Each engagement starts with a Scope of Work (SOW)—a shared under-standing of what we’re solving.
    </div>
    <div class="connector"></div>

    <!-- Decision Diamond -->
    <div class="decision" style="margin-top: 50px">
        <div>
            <strong>1 - Scope</strong><br>
            Each engagement starts with a Scope of Work (SOW)—a shared under-standing of what we’re solving.
        </div>
    </div>

    <!-- Horizontal connectors with labels -->
    <div style="display: flex; align-items: center; justify-content: center; margin: 20px 0;">
        <div class="horizontal-line">
            <div class="label-left">Fixed</div>
        </div>
        <div style="width: 80px;"></div>
        <div class="horizontal-line">
            <div class="label-right">Flexible</div>
        </div>
    </div>

    <!-- Bottom steps for Fixed and Flexible -->
    <div style="display: flex; justify-content: center;">
        <div class="step">Fixed Path Content</div>
        <div style="width: 80px;"></div>
        <div class="step">Flexible Path Content</div>
    </div>

    <div class="step">
        1 - Scope
        <br>
        Each engagement starts with a Scope of Work (SOW)—a shared under-standing of what we’re solving.
    </div>

</div>
