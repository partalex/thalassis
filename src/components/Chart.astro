<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Perfect Flowchart</title>
        <style>
            body {
                font-family: Arial, sans-serif;
            }

            .flowchart {
                position: relative;
                display: flex;
                flex-direction: column;
                align-items: center;
            }

            .step,
            .decision {
                border: 1px solid #000;
                padding: 15px;
                text-align: center;
                width: 250px;
                border-radius: 10px;
                background: #fff;
            }

            .connector {
                width: 2px;
                height: 40px;
                background: #000;
            }

            .decision {
                width: 250px;
                height: 250px;
                transform: rotate(45deg);
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                margin: 40px 0;
            }

            .decision-content {
                transform: rotate(-45deg);
                width: 180px;
            }

            /* Branch lines */
            .h-line,
            .v-line {
                position: absolute;
                background: #000;
            }

            .h-line {
                height: 2px;
                width: 100px;
                top: calc(50% + 35px);
            }

            .h-line.left {
                left: calc(50% - 273px);
            }

            .h-line.right {
                right: calc(50% - 273px);
            }

            .v-line {
                width: 1px;
                height: 400px;
                top: calc(50% + 35px);
            }

            .v-line.left {
                left: calc(50% - 273px);
            }

            .v-line.right {
                right: calc(50% - 273px);
            }

            .h1-line {
                position: absolute;
                height: 2px;
                width: 149px;
                background: #000;
                top: calc(50% + 435px);
            }

            .h1-line.left {
                left: calc(50% - 273px);
            }

            .h1-line.right {
                right: calc(50% - 273px);
            }

            .label {
                position: absolute;
                writing-mode: vertical-rl;
                font-weight: bold;
                font-size: 50px; /* ← POVEĆAJ VELIČINU TEKSTA */
                line-height: 1.2; /* ← RAZMAK IZMEĐU SLOVA */
            }

            .label.left {
                left: calc(50% - 330px);
                top: calc(68%);
                transform: rotate(180deg);
            }

            .label.right {
                right: calc(50% - 330px);
                top: calc(65%);
            }

            .bottom-step {
                margin-top: 160px;
            }
        </style>
    </head>
    <body>
        <div class="flowchart">
            <!-- Top step -->
            <div class="step">
                <strong>1 - Scope</strong><br />
                Each engagement starts with a Scope of Work (SOW)—a shared understanding
                of what we’re solving.
            </div>

            <div class="connector"></div>

            <!-- Middle step -->
            <div class="step">
                <strong>1 - Scope</strong><br />
                Each engagement starts with a Scope of Work (SOW)—a shared understanding
                of what we’re solving.
            </div>

            <div class="connector"></div>

            <!-- Diamond -->
            <div class="decision">
                <div class="decision-content">
                    <strong>1 - Scope</strong><br />
                    Each engagement starts with a Scope of Work (SOW)—a shared understanding
                    of what we’re solving.
                </div>
            </div>

            <!-- Branch lines -->
            <div class="h-line left"></div>
            <div class="h-line right"></div>

            <div class="v-line left"></div>
            <div class="v-line right"></div>

            <div class="label left">Fixed</div>
            <div class="label right">Flexible</div>

            <div class="h1-line left"></div>
            <div class="h1-line right"></div>

            <!-- Bottom step -->
            <div class="step bottom-step">
                <strong>1 - Scope</strong><br />
                Each engagement starts with a Scope of Work (SOW)—a shared understanding
                of what we’re solving.
            </div>
        </div>
    </body>
</html>
