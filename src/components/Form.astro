---

<style>
    .form-label {
        font-weight: 200;
    }
    .form-control{
        font-weight: 100;
    }
    .form-select{
        font-weight: 100;
    }

</style>

<form method="POST" action="api/submit">
    <div class="mb-3">
        <label for="fullName" class="form-label like-p ms-3">Full Name*</label>
        <input type="text" class="form-control like-p" id="fullName" placeholder="Write Your Full Name" required>
    </div>
    <div class="mb-3">
        <label for="emailAddress" class="form-label ms-3">E-mail Address*</label>
        <input type="email" class="form-control" id="emailAddress" placeholder="Write Your E-mail Address"
               required>
    </div>
    <div class="mb-3">
        <label for="companyName" class="form-label ms-3">Company Name*</label>
        <input type="text" class="form-control" id="companyName" placeholder="Write Your Company Name"
               required>
    </div>
    <div class="mb-3">
        <label for="timeline" class="form-label ms-3">Timeline*</label>
        <select class="form-select" id="timeline" required>
            <option selected disabled value="">e.g. Fixed</option>
            <option>Fixed</option>
            <option>Flexible</option>
            <option>Ongoing</option>
        </select>
    </div>
    <div class="row mb-3">
        <div class="col-md-6">
            <label for="startDate" class="form-label ms-3">Start-Date*</label>
            <div class="input-group">
                <input type="date" class="form-control" id="startDate" placeholder="e.g. 06/06/2025"
                       required>
                <span class="input-group-text"><i class="bi bi-calendar"></i></span>
            </div>
        </div>
        <div class="col-md-6">
            <label for="endDate" class="form-label ms-3">End-Date*</label>
            <div class="input-group">
                <input type="date" class="form-control" id="endDate" placeholder="e.g. 06/12/2025" required>
                <span class="input-group-text"><i class="bi bi-calendar"></i></span>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label for="budget" class="form-label ms-3">Budget*</label>
        <select class="form-select" id="budget" required>
            <option selected disabled value="">e.g. 150 - 250 k</option>
            <option>100k - 200k</option>
            <option>200k - 300k</option>
            <option>300k+</option>
        </select>
    </div>
    <div class="mb-3">
        <label for="note" class="form-label ms-3">Note</label>
        <textarea class="form-control" id="note" rows="5" placeholder="Write Your Message"></textarea>
    </div>
</form>
