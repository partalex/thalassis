---
const timelines: string[] = [
    "Fixed",
    "Flexible",
    "Ongoing"
];
const budgets: string[] = [
    "<50k",
    "50-150k",
    "150k-250k",
    "250k-500k",
    "500k+"
]
---

<style>
    .form-label {
        font-weight: 200;
    }

    .form-control {
        font-weight: 100;
    }

    .dropdown-menu .dropdown-item:hover,
    .dropdown-menu .dropdown-item:focus {
        //font-weight: 200;
        //font-family: "Source Sans 3", sans-serif;
        background-color: black;
        color: white;
        font-weight: lighter;
    }


</style>
<link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"
/>
<form method="POST">
    <div class="mb-3">
        <label for="fullName" class="form-label like-p ms-3">Full Name*</label>
        <input
                type="text"
                class="form-control like-p"
                id="fullName"
                placeholder="Write your full name"
                required
        />
    </div>
    <div class="mb-3">
        <label for="emailAddress" class="form-label ms-3">Email Address*</label
        >
        <input
                type="email"
                class="form-control"
                id="emailAddress"
                placeholder="Write your email address"
                required
        />
    </div>
    <div class="mb-3">
        <label for="companyName" class="form-label ms-3">Company Name*</label>
        <input
                type="text"
                class="form-control"
                id="companyName"
                placeholder="Write your company name"
                required
        />
    </div>
    <div class="mb-3">
        <label for="timelineDropdown" class="form-label ms-3">Timeline*</label>
        <div class="dropdown">
            <button class="btn border dropdown-toggle w-100 text-start" style="font-weight: 100" type="button"
                    id="timelineDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">e.g. Fixed
            </button>
            <ul class="dropdown-menu" aria-labelledby="timelineDropdown">
                {timelines.map((item) => (
                        <li>
                            <button type="button" class="dropdown-item" style="font-weight: 100"
                                    onclick={`selectTimeline('${item}')`}>
                                {item}
                            </button>
                        </li>
                ))}
            </ul>
        </div>
        <input type="hidden" name="timeline" id="timelineHidden">
    </div>
    <div class="row mb-3">
        <div class="col-md-6 mb-3 mb-md-0">
            <label for="startDate" class="form-label ms-3">Start Date*</label>
            <div class="input-group">
                <input type="text" id="startDate" class="form-control" placeholder="e.g. 06/12/2025"/>
                <span class="input-group-text" id="startDateIcon">
                    <i class="ph ph-calendar-blank"></i>
                </span>
            </div>
        </div>
        <div class="col-md-6">
            <label for="endDate" class="form-label ms-3">End Date*</label>
            <div class="input-group" id="endDateWrap" data-input>
                <input
                        type="text"
                        class="form-control"
                        id="endDate"
                        placeholder="e.g. 06/12/2025"
                        data-input
                />
                <span class="input-group-text" data-toggle id="endDateIcon">
                    <i class="ph ph-calendar-blank"></i>
                </span>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label for="budgetDropdown" class="form-label ms-3">Budget*</label>
        <div class="dropdown">
            <button class="btn border dropdown-toggle w-100 text-start" style="font-weight: 100" type="button"
                    id="budgetDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">e.g. 150k-250k
            </button>
            <ul class="dropdown-menu" aria-labelledby="budgetDropdown">
                {budgets.map((item) => (
                        <li>
                            <button type="button" class="dropdown-item" style="font-weight: 100"
                                    onclick={`selectBudget('${item}')`}>
                                {item}
                            </button>
                        </li>
                ))}
            </ul>
        </div>
        <input type="hidden" name="budget" id="budgetHidden">
    </div>
    <div class="mb-3">
        <label for="note" class="form-label ms-3">Note</label>
        <textarea
                class="form-control"
                id="note"
                rows="5"
                placeholder="Write your message"></textarea>
    </div>

</form>
<script type="module" is:inline>
    import flatpickr from "https://cdn.skypack.dev/flatpickr";

    const startInput = document.getElementById("startDate");
    const endInput = document.getElementById("endDate");
    const startIcon = document.getElementById("startDateIcon");
    const endIcon = document.getElementById("endDateIcon");

    const startPicker = flatpickr(startInput, {
        dateFormat: "m/d/Y",
        appendTo: document.body,
        position: "auto center",
    });

    const endPicker = flatpickr(endInput, {
        dateFormat: "m/d/Y",
        appendTo: document.body,
        position: "below left",
    });

    startIcon.addEventListener("click", () => {
        startPicker.open();
    });

    endIcon.addEventListener("click", () => {
        endPicker.open();
    });

    // Timeline dropdown handler
    window.selectTimeline = function (value) {
        document.getElementById('timelineDropdown').textContent = value;
        document.getElementById('timelineHidden').value = value;
    };

    // Budget dropdown handler
    window.selectBudget = function (value) {
        document.getElementById('budgetDropdown').textContent = value;
        document.getElementById('budgetHidden').value = value;
    };

    // check if empty function
    function isEmpty(value) {
        return value === null || value === undefined || value.trim() === '';
    }

    function alertIfEmpty(value, fieldName) {
        if (isEmpty(value)) {
            alert(`${fieldName} is required.`);
            return true;
        }
        return false;
    }

    const submitBtn = document.getElementById('submitButton');
    if (submitBtn) {
        submitBtn.addEventListener('click', function (e) {
            e.preventDefault();
            const fullName = document.getElementById('fullName').value;
            const email = document.getElementById('emailAddress').value;
            const company = document.getElementById('companyName').value;
            const timeline = document.getElementById('timelineHidden').value;
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            const budget = document.getElementById('budgetHidden').value;
            const note = document.getElementById('note').value;


            if (
                alertIfEmpty(fullName, 'Full Name') ||
                alertIfEmpty(email, 'Email Address') ||
                alertIfEmpty(company, 'Company Name') ||
                alertIfEmpty(timeline, 'Timeline') ||
                alertIfEmpty(startDate, 'Start Date') ||
                alertIfEmpty(endDate, 'End Date') ||
                alertIfEmpty(budget, 'Budget')
            )
                return;

            console.log('Full Name:', fullName);
            console.log('Email:', email);
            console.log('Company:', company);
            console.log('Timeline:', timeline);
            console.log('Start Date:', startDate);
            console.log('End Date:', endDate);
            console.log('Budget:', budget);
            console.log('Note:', note);


            if (!confirm('Are you sure you want to submit the form?'))
                return;

            // do smth for cloud flare  worker or whaterver is needed
            // await submitFormData({
            //     fullName,
            //     email,
            //     company,
            //     timeline,
            //     startDate,
            //     endDate,
            //     budget,
            //     note
            // });

            // setTimeout(() => {
            //     confirm('Form submitted successfully!')
            // });
            window.location.href = '/';
        });
    }

    async function submitFormData(formData) {
        try {
            const response = await fetch('https://your-worker-subdomain.workers.dev/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            });
            if (!response.ok) throw new Error('Network response was not ok');
            alert('Form submitted successfully!');
            window.location.href = '/';
        } catch (error) {
            alert('There was a problem submitting the form: ' + error.message);
        }
    }
</script>
