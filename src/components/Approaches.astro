---
const approaches: ApproachItem[] = [
    {
        title: "Scope",
        subTitle1: null,
        desc1: "Each engagement starts with a Scope of Work (SOW)—a shared understanding of what we're solving. We break down your goals into tangible deliverables called Units of Work (UOW).",
        subTitle2: null,
        desc2: "We break down your goals into tangible deliverables called Units of Work (UOW).",
    },
    {
        title: "Estimate",
        subTitle1: null,
        desc1: "Each UOW is estimated in Full Stack Days (FSDs): one day of coordinated output from a core contributor and supporting team, rather than just an average (blended) rate.",
        subTitle2: null,
        desc2: "We break down your goals into tangible deliverables called Units of Work (UOW).",
    },
    {
        title: "Choose Pricing Model",
        subTitle1: "Fixed Billing:",
        desc1: "Pay the upper bound of our estimate (the pessimistic case). You cap risk and lock in a known cost.",
        subTitle2: "Flexible Billing:",
        desc2: "Pay only for the actual FSDs used. If a UOW takes less time, you pay less. If it takes more, you’re billed only for what was actually consumed.",
    },
    {
        title: "Deliver",
        subTitle1: null,
        desc1: "Every month, you get a clear invoice—our line items are deliverables (UOWs), not resources.",
        subTitle2: null,
        desc2: null,
    }
]
---
<style>
    .accordion-button {
        background-color: black !important;
        color: white !important;
    }

    .accordion-button::after {
        filter: invert(1); /* strelica bela */
    }

    .accordion-body {
        background-color: black;
        color: white;
    }

    .accordion-item {
        margin-bottom: 15px; /* Dodaje prostor između accordion elemenata */
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .accordion-item:first-of-type {
        border-top-left-radius: 0.5rem;
        border-top-right-radius: 0.5rem;
    }

    .accordion-item:last-of-type {
        border-bottom-left-radius: 0.5rem;
        border-bottom-right-radius: 0.5rem;
    }
</style>

<h1 class="fw-bold">Our Approach</h1>
<br>

<p>Here’s how we scope, price, and deliver work—from the first conversation to the final invoice.</p>
<br>


<div class="accordion accordion-flush" id="accordionFlushExample">
    {approaches.map((app, index) => (
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target={`#flush-collapse${index}`} aria-expanded="false"
                            aria-controls={`#flush-collapse${index}`}>
                        {index + 1}. {app.title}
                    </button>
                </h2>
                <div id={`flush-collapse${index}`} class="accordion-collapse collapse"
                    data-bs-parent="#accordionFlushExample">
                <div class="accordion-body">{app.desc1}</div>
                </div>
            </div>
    ))}

</div>





