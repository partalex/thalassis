<h1> Our Approach</h1>
<br>

<p>Here’s how we scope, price, and deliver work—from the first conversation to the final invoice.</p>
<br>

<div class="row row-cols-1 row-cols-md-2 g-4 px-4">

    {approaches.map((approach, index) => (
            <div class="col">

                <div class="card rounded-4 shadow">
                    <div class="card-header bg-white p-4 pb-0 border-0">
                        <h4 class="card-title mb-3">{approach.title}</h4>
                    </div>
                    <div class="card-body p-4 pt-0">
                        {approach.subTitle1 && <h5 class="card-subtitle mb-2 text-dark">{approach.subTitle1}</h5>}
                        <p class="card-text mb-4">{approach.desc1}</p>
                        {approach.subTitle2 && <h5 class="card-subtitle mb-2 text-dark">{approach.subTitle2}</h5>}
                        {approach.desc2 && <p class="card-text">{approach.desc2}</p>}
                    </div>
                    <div class="card-footer bg-secondary text-white p-1 rounded-bottom-4 border-0">
                        <span class="ps-3 fs-1 fw-bold">0{index + 1}</span>
                    </div>
                </div>

            </div>
    ))}
</div>

