    {
        title: "Scope",
        subTitle1: null,
        desc1: "Each engagement starts with a Scope of Work (SOW)—a shared understanding of what we're solving. We break down your goals into tangible deliverables called Units of Work (UOW).",
        subTitle2: null,
        desc2: "We break down your goals into tangible deliverables called Units of Work (UOW).",
    },
    {
        title: "Estimate",
        subTitle1: null,
        desc1: "Each UOW is estimated in Full Stack Days (FSDs): one day of coordinated output from a core contributor and supporting team, rather than just an average (blended) rate.",
        subTitle2: null,
        desc2: "We break down your goals into tangible deliverables called Units of Work (UOW).",
    },
    {
        title: "Choose Pricing Model",
        subTitle1: "Fixed Billing:",
        desc1: "Pay the upper bound of our estimate (the pessimistic case). You cap risk and lock in a known cost.",
