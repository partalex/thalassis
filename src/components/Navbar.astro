---
const navLinks: NavLink[] = [
    { href: "/#about", name: "About Us" },
    { href: "/case-studies", name: "Case Studies" },
    { href: "/contact", name: "Contact Us" },
];
const logoPath = "logo/png/Thalassis Consulting-01 - Black.png";
---

<style>
    .logo {
        height: 50px;
    }

    .navbar-nav .nav-item {
        width: 125px;
        height: 50px;
        transition: background-position-x 0.9s linear;
        text-align: center;
    }

    .navbar-nav .nav-item:hover {
        background: url("data:image/svg+xml;base64,");
        animation: line 1s;
    }

    @keyframes line {
        0% {
            background-position-x: 390px;
        }
    }

    .offcanvas {
        width: 100% !important;
    }

    .offcanvas-header img {
        height: 150px;
    }

    .offcanvas-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center; 
        gap: 2rem; 
        padding-top: 2rem;
    }

    .offcanvas-body .nav-item {
        text-align: center;
        margin-bottom: 2rem;
    }

    .offcanvas-body .nav-link {
        white-space: nowrap;
        font-weight: 600;
        font-size: 1.5rem;
        
    }
</style>

<nav class="navbar navbar-expand-md">
    <div class="container-fluid mb-5 mt-5 ps-0">
        <a class="navbar-brand" href="/">
            <img src={logoPath} alt="Logo" class="logo" />
        </a>

        <button
            class="navbar-toggler d-md-none"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#offcanvasNavbar"
            aria-controls="offcanvasNavbar"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <ul class="navbar-nav ms-auto gap-4 d-none d-md-flex">
            {
                navLinks.map((link) => (
                    <li class="nav-item">
                        <a class="nav-link" href={link.href}>
                            {link.name}
                        </a>
                    </li>
                ))
            }
        </ul>

        <div
            class="offcanvas offcanvas-end d-md-none"
            tabindex="-1"
            id="offcanvasNavbar"
            aria-labelledby="offcanvasNavbarLabel"
        >
            <div class="offcanvas-header">
                <img src={logoPath} alt="Logo" class="img-fluid p-4 re-2" />
                <button
                    type="button"
                    class="btn-close text-reset"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <ul class="navbar-nav justify-content-center flex-grow-1">
                    {
                        navLinks.map((link) => (
                            <li class="nav-item">
                                <a class="nav-link" href={link.href}>
                                    {link.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</nav>

<script is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    // ✅ Defensive check
    if (typeof bootstrap !== "undefined") {
      const offcanvasElement = document.getElementById("offcanvasNavbar");
      const navLinks = document.querySelectorAll(".offcanvas .nav-link");
      const offcanvasInstance = bootstrap.Offcanvas.getOrCreateInstance(offcanvasElement);

      navLinks.forEach(link => {
        link.addEventListener("click", () => {
          offcanvasInstance.hide();
        });
      });
    } else {
      console.warn("⚠️ Bootstrap JS is not loaded. Offcanvas links won't close automatically.");
    }
  });
</script>

