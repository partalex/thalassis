---
const navLinks: NavLink[] = [
    { href: "/#about", name: "About Us" },
    { href: "/case-studies", name: "Case Studies" },
    { href: "/contact", name: "Contact Us" },
];
const logoPath = "/logo/svg/THALASSIS CONSULTING LOGO-Black.svg";
---

<style>
    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        height: 200px;
    }

    .nav-list {
        display: flex;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .menu li {
        width: 125px;
        height: 50px;
        transition: background-position-x 0.9s linear;
        text-align: center;
    }

    .menu li:hover {
        background: url("data:image/svg+xml;base64,");
        animation: line 1s;
    }

    .menu li:hover a {
        color: gray;
    }

    @keyframes line {
        0% {
            background-position-x: 390px;
        }
    }

    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
    }

    .burger-wrapper {
        position: relative;
    }

    .burger {
        display: none;
        font-size: 2rem;
        background: none;
        border: none;
        cursor: pointer;
        color: black;
    }

    .nav-list {
        display: flex;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* Mobile styles */
    @media (max-width: 768px) {
        .nav-list {
            flex-direction: column;
            position: absolute;
            top: 100%;
            right: 0;
            background: white;
            width: 200px;
            display: none;
            padding: 1rem; /* dodaj padding za prostor */
            gap: 1rem; /* lepi razmak izmedju linkova */
        }

        .nav-list.show {
            display: flex;
        }

        .burger {
            display: block;
        }
    }
</style>

<nav class="navbar">
    <a class="navbar-brand" href="/">
        <img src={logoPath} alt="Thalassis Consulting Logo" class="logo" />
    </a>

    <div class="burger-wrapper">
        <button class="burger" id="burger">&#9776;</button>
        <ul class="menu nav-list" id="nav-list">
            {
                navLinks.map((link) => (
                    <li>
                        <a class="nav-link" href={link.href}>
                            {link.name}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const burger = document.getElementById("burger");
        const navList = document.getElementById("nav-list");

        if (burger && navList) {
            burger.addEventListener("click", () => {
                navList.classList.toggle("show");
            });
        }
    });
</script>
