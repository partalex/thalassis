---
const navLinks = [
    {href: "/about", name: "About Us"},
    {href: "/case-studies", name: "Case Studies"},
    {href: "/contact", name: "Contact Us"}
];
---
<nav class="navbar bg-dark navbar-expand-lg border-bottom border-body" data-bs-theme="dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <img src="/public/favicon.svg" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">
            Thalassis
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>


        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                {navLinks.map(link => (
                        <li class="nav-item">
                            <a class="nav-link" aria-current="page" href={link.href}>{link.name}</a>
                        </li>
                ))}
            </ul>
        </div>
    </div>
</nav>

