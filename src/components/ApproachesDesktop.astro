---
const approaches: ApproachItem[] = [
    {
        title: "Scope",
        subTitle1: null,
        desc1: "Each engagement starts with a Scope of Work (SOW)—a shared understanding of what we're solving. We break down your goals into tangible deliverables called Units of Work (UOW).",
        subTitle2: null,
        desc2: "We break down your goals into tangible deliverables called Units of Work (UOW).",
    },
    {
        title: "Estimate",
        subTitle1: null,
        desc1: "Each UOW is estimated in Full Stack Days (FSDs): one day of coordinated output from a core contributor and supporting team, rather than just an average (blended) rate.",
        subTitle2: null,
        desc2: "You’ll see your entire project—scope, delivery, and cost—measured in the same unit",
    },
    {
        title: "Choose Pricing Model",
        subTitle1: "Fixed Billing:",
        desc1: "Pay the upper bound of our estimate (the pessimistic case). You cap risk and lock in a known cost.",
        subTitle2: "Flexible Billing:",
        desc2: "Pay only for the actual FSDs used. If a UOW takes less time, you pay less. If it takes more, you’re billed only for what was actually consumed.",
    },
    {
        title: "Deliver",
        subTitle1: null,
        desc1: "Every month, you get a clear invoice—our line items are deliverables (UOWs), not resources.",
        subTitle2: null,
        desc2: null,
    }
]
---

<style>
    .flip-card {
        position: relative;
        width: 100%;
        min-height: 320px; /* dodaj minimalnu visinu */
        height: 100%; /* pusti da raste */
        overflow: hidden;
        border-radius: 0.5rem;
        display: flex;
        flex-direction: column;
    }

    .flip-card-inner {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .flip-card-front {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .flip-card-back {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #1a1a1a;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 0.5rem;
        //transition: transform 1.2s ease, opacity 1.2s ease;
        transition: transform 0.75s ease, opacity 0.75s ease;
        z-index: 2;
        transform: translateY(0%);
    }

    .flip-card:hover .flip-card-back {
        transform: translateY(100%);
        opacity: 0;
    }

    .flip-card-back h2 {
        transform: scale(1);
        opacity: 1;
        transition: transform 1.2s ease, opacity 1.2s ease;
    }

    .flip-card:hover .flip-card-back h2 {
        transform: scale(0.4);
        opacity: 0;
    }

    .flip-card:hover .flip-card-back {
        transform: translateY(50%);
        opacity: 0;
    }

</style>

<h1> Our Approach</h1>
<br>

<p>
    Here’s how we scope, price, and deliver work—from the first conversation to the final invoice.
</p>
<br>
<br>

<div class="d-flex justify-content-center mb-5">
    {approaches.slice(0,2).map((app, index) => (
            <div class={`flip-card me-4 ${index === 0 ? "me-4" : "ms-4"}`}
                 style="max-width: 433px; height: 433px">
                <div class="flip-card-inner">
                    <!-- BACK FACE -->
                    <div class="flip-card-back">
                        <!--<h2 style="font-size: 170px;">{index + 1}</h2>-->
                        <h2 style="font-size: 40px;" class="text-center">{index + 1}. {app.title} </h2>
                    </div>
                    <!-- FRONT FACE -->
                    <div class="flip-card-front card shadow-sm border rounded-4">
                        <div class="card-body p-4 flex-grow-1">
                            <h5 class="card-title fw-bold mb-5">{app.title}</h5>
                            <h6 class="card-subtitle mb-1">{app.subTitle1}</h6>
                            <p class="mb-4">{app.desc1}</p>
                            <h6 class="card-subtitle mb-1">{app.subTitle2}</h6>
                            {app.desc2 && <p>{app.desc2}</p>}
                        </div>
                        <div class=" text-center" style="background-color: #808080; color: white;">
                            <h2 style="font-size: 40px!important;" class="ps-3 pt-2">{index + 1}</h2>
                        </div>
                    </div>
                </div>
            </div>
    ))}
</div>

<div class="d-flex justify-content-center mt-4">
    {approaches.slice(2,4).map((app, index) => (
            <div class={`flip-card me-4 ${index === 0 ? "me-4" : "ms-4"}`}
                 style="max-width: 433px; height: 433px">
                <div class="flip-card-inner">
                    <!-- BACK FACE -->
                    <div class="flip-card-back">
                        <h2 style="font-size: 40px;" class="text-center">{index + 3}. {app.title} </h2>
                    </div>
                    <!-- FRONT FACE -->
                    <div class="flip-card-front card shadow-sm border rounded-4">
                        <div class="card-body p-4 flex-grow-1">
                            <h5 class="card-title fw-bold mb-5">{app.title}</h5>
                            <h6 class="card-subtitle mb-1">{app.subTitle1}</h6>
                            <p class="mb-4">{app.desc1}</p>
                            <h6 class="card-subtitle mb-1">{app.subTitle2}</h6>
                            {app.desc2 && <p>{app.desc2}</p>}
                        </div>
                        <div class=" text-center" style="background-color: #808080; color: white;">
                            <h2 style="font-size: 40px!important;" class="ps-3 pt-2">{index + 3}</h2>
                        </div>
                    </div>
                </div>
            </div>
    ))}
</div>
