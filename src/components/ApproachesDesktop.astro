---
const approaches: ApproachItem[] = [
    {
        title: "Scope",
        subTitle1: null,
        desc1: "Each engagement starts with a Scope of Work (SOW)—a shared understanding of what we're solving. We break down your goals into tangible deliverables called Units of Work (UOW).",
        subTitle2: null,
        desc2: "We break down your goals into tangible deliverables called Units of Work (UOW).",
    },
    {
        title: "Estimate",
        subTitle1: null,
        desc1: "Each UOW is estimated in Full Stack Days (FSDs): one day of coordinated output from a core contributor and supporting team, rather than just an average (blended) rate.",
        subTitle2: null,
        desc2: "We break down your goals into tangible deliverables called Units of Work (UOW).",
    },
    {
        title: "Choose Pricing Model",
        subTitle1: "Fixed Billing:",
        desc1: "Pay the upper bound of our estimate (the pessimistic case). You cap risk and lock in a known cost.",
        subTitle2: "Flexible Billing:",
        desc2: "Pay only for the actual FSDs used. If a UOW takes less time, you pay less. If it takes more, you’re billed only for what was actually consumed.",
    },
    {
        title: "Deliver",
        subTitle1: null,
        desc1: "Every month, you get a clear invoice—our line items are deliverables (UOWs), not resources.",
        subTitle2: null,
        desc2: null,
    }
]
---

<style>
.flip-card {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border-radius: 0.5rem;
}

.flip-card-inner {
  width: 100%;
  height: 100%;
  position: relative;
}

.flip-card-front {
  position: relative;
  width: 100%;
  height: 100%;
  background: white;
  box-shadow: 0 4px 8px rgba(0,0,0,0.2);
  z-index: 1;
  border-radius: 0.5rem;
  overflow: hidden;
}

.flip-card-back {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #1a1a1a;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 80px;
  border-radius: 0.5rem;
  transition: top 0.8s ease, opacity 0.8s ease, height 0.8s ease;
  z-index: 2;
}

.flip-card:hover .flip-card-back {
  top: 100%;
  opacity: 0;
  height: 60px;
}

</style>

<h1> Our Approach</h1>
<br>

<p>
    Here’s how we scope, price, and deliver work—from the first conversation to the final invoice.
</p>
<br>
<br>

<div class="row row-cols-1 row-cols-md-2 g-5 px-md-5">
  {approaches.map((app, index) => (
    <div class="col">
      <div class="flip-card">
        <div class="flip-card-inner">
          <!-- BACK FACE -->
          <div class="flip-card-back">
            <h2 style="font-size: 100px;">0{index + 1}</h2>
          </div>
          <!-- FRONT FACE -->
          <div class="flip-card-front card shadow-sm border rounded-4">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold mb-5">{app.title}</h5>
                <h6 class="card-subtitle mb-4">{app.subTitle1}</h6>
                <p class="mb-4">{app.desc1}</p>
                <h6 class="card-subtitle mb-4">{app.subTitle2}</h6>
                {app.desc2 && <p>{app.desc2}</p>}
            </div>
            <div class="card-footer text-center" style="background-color: #808080; color: white;">
                <h2 style="font-size: 40px!important;">0{index + 1}</h2>
            </div>
            </div>
        </div>
      </div>
    </div>
  ))}
</div>
