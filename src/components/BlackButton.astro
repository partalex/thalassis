---
const {label, link} = Astro.props;
---

<style>
    .a {
        font-weight: 300;
        max-width: 200px !important;
        //width: 150px !important;
    }

    .offset-shadow {
        background: black;
        box-shadow: 0.3em 0.3em 0 white;
        border: 1px solid #979695;

        transition: box-shadow 0.3s ease,
        transform 0.3s ease,
        background 0.3s ease,
        color 0.3s ease;
    }

    .offset-shadow:hover {
        /* Flip shadow direction: top-left is negative offset */
        box-shadow: -0.3em -0.3em 0 black;

        background: #ffffff;
        color: black;
        transform: translate(-0.3em, -0.3em);
    }
</style>

<a
        href={link}
        class="btn btn-dark btn-lg black-btn offset-shadow"
        style="border-radius: 3px;
    font-weight: 200;
    min-width: 160px;
    min-height: 40px;
    font-size: 1rem;
   "
>{label}</a
>
