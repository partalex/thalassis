---
const socials: Social[] = [
    {
        icon: "bi-geo-alt",
        link: "160 Robinson Road, Singapore (068914)",
    },
    {
        icon: "bi-envelope",
        link: "hello@thalassis.co",
    },
    {
        icon: "bi-linkedin",
        link: "linkedin.com/company/thalassis-consulting",
    },
];
import LightFullButton from "./LightFullButton.astro";
---

<style>
    .footer-desktop {
        display: block;
    }

    .footer-mobile {
        display: none;
    }

    @media (max-width: 768px) {
        .footer-desktop {
            display: none;
        }

        .footer-mobile {
            display: block;
        }
    }
    .socials-list li {
        font-size: 1rem;
    }

    .socials-list li i {
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .socials-list li span {
        display: inline-block;
    }
</style>

<!-- Desktop Footer -->
<footer class="footer-desktop bg-black text-white py-5">
    <div class="container">
        <div class="row align-items-center text-md-start">
            <!-- Left -->
            <div class="col-md-4 mb-4 mb-md-0 text-center">
                <h5 class="fw-bold mb-3">Got a project in mind?</h5>
                <LightFullButton darkMode="false" label="Let’s Talk" link="/" />
            </div>

            <!-- Middle -->
            <div class="col-md-4 mb-4 mb-md-0">
                <ul class="list-unstyled socials-list">
                    {
                        socials.map((item) => (
                            <li class="mb-3 d-flex align-items-center">
                                <i class={`bi ${item.icon} me-3 fs-3`} />
                                <span>{item.link}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Right -->
            <div class="col-md-4 d-flex flex-column align-items-center justify-content-start">
                <img
                    src="/logo/png/Thalassis Consulting-02 - White.png"
                    alt="Thalassis Consulting Logo"
                    style="max-width: 300px; height: auto;"
                />
                <p class="small" style="margin-top: 55px;">
                    &copy; 2025 Thalassis Consulting Pte. Ltd. All rights
                    reserved.
                </p>
            </div>
        </div>
    </div>
</footer>

<!-- Mobile Footer -->
<footer class="footer-mobile bg-black text-white py-5">
    <div class="container d-flex flex-column align-items-center text-center">
        <!-- Logo -->
        <img
            src="/logo/png/Thalassis Consulting-02 - White.png"
            alt="Thalassis Consulting Logo"
            style="max-width: 250px; height: auto;"
            class="mb-4"
        />

        <!-- Links -->
        <ul class="list-unstyled socials-list mb-4">
            {
                socials.map((item) => (
                    <li class="mb-3 d-flex align-items-center justify-content-center">
                        <i class={`bi ${item.icon} me-3 fs-3`} />
                        <span>{item.link}</span>
                    </li>
                ))
            }
        </ul>

        <!-- CTA -->
        <div class="mb-4">
            <h5 class="fw-bold mb-3">Got a project in mind?</h5>
            <LightFullButton darkMode="false" label="Let’s Talk" link="/" />
        </div>

        <!-- Copyright -->
        <p class="small mb-0">
            &copy; 2025 Thalassis Consulting Pte. Ltd. All rights reserved.
        </p>
    </div>
</footer>
