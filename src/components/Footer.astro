---
const socials: Social[] = [
  {
    icon: "bi-geo-alt",
    link: "160 Robinson Road, Singapore (068914)"
  },
  {
    icon: "bi-envelope",
    link: "hello@thalassis.co"
  },
  {
    icon: "bi-linkedin",
    link: "linkedin.com/company/thalassis-consulting"
  }
];
import LightFullButton from "./LightFullButton.astro";
---

<footer class="bg-black text-white py-5">
  <div class="container">
    <div class="row align-items-center">

      <!-- Left Section -->
      <div class="col-md-4 mb-4 mb-md-0 mx-auto text-center">
        <div class="d-flex flex-column align-items-center">
          <h5 class="fw-bold mb-3">Got a project in mind?</h5>
          <LightFullButton darkMode="false" label="Let’s Talk" link="/" />
        </div>
      </div>

      <!-- Middle Section -->
      <div class="col-md-4 mb-4 mb-md-0">
        <ul class="list-unstyled">
          {socials.map((item) => (
            <li class="mb-2 d-flex align-items-center">
              <i class={`bi ${item.icon} me-2`}></i>
              {item.link}
            </li>
          ))}
        </ul>
      </div>

      <!-- Right Section -->
      <div class="col-md-4 mx-auto text-center">
        <img
          src="/logo/svg/THALASSIS CONSULTING LOGO-White.svg"
          alt="Thalassis Consulting Logo"
          class="mb-2"
          style="max-width: 220px;"
        />
        <p class="small mb-0">&copy; 2025 Thalassis Consulting Pte. Ltd. All rights reserved.</p>
      </div>

    </div>
  </div>
</footer>