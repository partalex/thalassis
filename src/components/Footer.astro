---
const socials: Social[] = [
    {
        icon: "bi-geo-alt",
        link: "160 Robinson Road, Singapore (068914)",
    },
    {
        icon: "bi-envelope",
        link: "hello@thalassis.co",
    },
    {
        icon: "bi-linkedin",
        link: "linkedin.com/company/thalassis-consulting",
    },
];
import LightFullButton from "./LightFullButton.astro";

const copyright = "© 2025 Thalassis Consulting Pte. Ltd. All rights reserved.";
---


<style>
    .margin{
        margin-right: -12px;
        margin-left: -12px;
        padding-left: 12px;
        padding-right: 12px;
    }
</style>

<!-- PC view -->
<footer class="d-none d-lg-block bg-black">
    <div class="row text-center pt-5 text-white-50">

        <div class="col-4 text-light">
            <h5 class="text-light mb-3">Got a project in mind?</h5>
            <LightFullButton darkMode="false" label="Let’s Talk" link="/"/>
        </div>

        <div class="col-4">
            <ul class="list-unstyled socials-list mb-4 text-start">
                {
                    socials.map((item) => (
                            <li class="mb-3 d-flex align-items-center">
                                <i class={`bi ${item.icon} me-3 fs-3`}/>
                                <span>{item.link}</span>
                            </li>
                    ))
                }
            </ul>
        </div>

        <div class="col-4 w-25 ">
            <img class="img-fluid mb-4"
                 src="/logo/png/Thalassis Consulting-02 - White.png"
                 alt="Thalassis Consulting Logo"
            />
            <p class="small mt-5">{copyright}</p>
        </div>

    </div>
</footer>

<!-- Mobile View  -->
<footer class="d-lg-none bg-black margin">
    <div class="row text-center pt-4 text-white-50">

        <div class="col-12 mt-4 mb-5">
            <img
                    src="/logo/png/Thalassis Consulting-02 - White.png"
                    alt="Thalassis Consulting Logo"
                    style="max-width: 260px; height: auto;"
                    class="mb-4">

        </div>

        <div class="col-12 mb-5">
            <ul class="list-unstyled socials-list mb-3">
                {
                    socials.map((item) => (
                            <li class="mb-3 d-flex justify-content-center align-items-center">
                                <i class={`bi ${item.icon} me-3 fs-3`}/>
                                <span>{item.link}</span>
                            </li>
                    ))
                }
            </ul>
        </div>

        <div class="col-12 mb-5">
            <h5 class="text-lighter mb-3">Got a project in mind?</h5>
            <LightFullButton darkMode="false" label="Let’s Talk" link="/"/>
        </div>

        <div class="col-12 pb-4">
            <p class="small mb-0">{copyright}</p>
        </div>

    </div>

</footer>

