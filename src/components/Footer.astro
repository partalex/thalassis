---
import DarkButton from "./DarkButton.astro";
---
<footer class="bg-dark text-white py-5">
    <div class="container">
        <div class="row text-center text-md-start align-items-center">

            <!-- Left Section -->
            <div class="col-md-4 mb-4 mb-md-0">
                <h5 class="fw-bold">Got a project in mind?</h5>
                <DarkButton darkMode="false" label="Let’s Talk" link="/"></DarkButton>
            </div>

            <!-- Middle Section -->
            <div class="col-md-4 mb-4 mb-md-0">
                <ul class="list-unstyled">
                    <li class="mb-2 d-flex align-items-center">
                        <i class="bi bi-geo-alt me-2"></i>
                        160 Robinson Road, Singapore (068914)
                    </li>
                    <li class="mb-2 d-flex align-items-center">
                        <i class="bi bi-envelope me-2"></i>
                        hello@thalassis.co
                    </li>
                    <li class="d-flex align-items-center">
                        <i class="bi bi-linkedin me-2"></i>
                        linkedin.com/company/thalassis-consulting
                    </li>
                </ul>
            </div>

            <!-- Right Section -->
            <div class="col-md-4 text-md-end">
                <img src="" alt="Thalassis Consulting Logo" class="mb-2" style="max-width: 180px;">
                <p class="small mb-0">&copy; 2025 Thalassis Consulting Pte. Ltd. All rights reserved.</p>
            </div>
        </div>
    </div>
</footer>
