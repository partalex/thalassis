---
const socials: Social[] = [
    {
        icon: "bi-geo-alt",
        link: "160 Robinson Road, Singapore (068914)",
    },
    {
        icon: "bi-envelope",
        link: "hello@thalassis.co",
    },
    {
        icon: "bi-linkedin",
        link: "linkedin.com/company/thalassis-consulting",
    },
];
import LightFullButton from "./LightFullButton.astro";
---

<style>
    .socials-list li {
        font-size: 1rem;
    }

    .socials-list li i {
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .socials-list li span {
        display: inline-block;
    }
</style>

<footer class="bg-black text-white py-5">
    <div class="container">
        <div class="row" style="min-height: 250px;">
            <!-- Left Section (vertikalno centralno) -->
            <div
                class="col-md-4 d-flex flex-column align-items-center justify-content-center"
            >
                <h5 class="fw-bold mb-3">Got a project in mind?</h5>
                <LightFullButton darkMode="false" label="Let’s Talk" link="/" />
            </div>

            <!-- Middle Section -->
            <div class="col-md-4 d-flex align-items-center">
                <ul class="list-unstyled socials-list">
                    {
                        socials.map((item) => (
                            <li class="mb-4 d-flex align-items-center">
                                <i class={`bi ${item.icon} me-3 fs-3`} />
                                <span>{item.link}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Right Section -->
            <div
                class="col-md-4 d-flex flex-column align-items-center justify-content-start"
            >
                <img
                    src="/logo/png/Thalassis Consulting-02 - White.png"
                    alt="Thalassis Consulting Logo"
                    style="max-width: 300px; height: auto;"
                />
                <p class="small" style="margin-top: 100px;">
                    <!-- povećaj ovu marginu -->
                    &copy; 2025 Thalassis Consulting Pte. Ltd. All rights reserved.
                </p>
            </div>
        </div>
    </div>
</footer>
